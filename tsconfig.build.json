// The browser code, without tests, compiled to ui/build/ (which index.html
// loads). crates/craft-status-app/build.rs runs this before every app build.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "noEmit": false,
    "outDir": "ui/build"
  },
  "exclude": ["ui/src/**/*.test.ts"]
}
